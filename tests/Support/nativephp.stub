<?php

// What src/Fakes uses of NativePHP, which is not a dependency of the plugin: the app has it.

namespace Native\Mobile\Edge\Contracts;

interface TreeObserver
{
    /**
     * @param  array<mixed>  $tree
     */
    public function tree(array $tree, string $uri): void;

    /**
     * @param  array<mixed>  $event
     */
    public function event(array $event, ?string $label): void;

    /**
     * @param  array<mixed>  $payload
     */
    public function nav(array $payload): void;
}

namespace Native\Mobile\Edge;

use Native\Mobile\Edge\Contracts\TreeObserver;

class TreeObservers
{
    public static function register(TreeObserver $observer): void {}
}

class NativeComponent
{
    /** @var \WeakReference<self>|null */
    private static ?\WeakReference $nativeActiveComponent = null;

    /** The fingerprint of the last frame published, from 4.7. */
    private ?string $publishedFrame = null;

    public static function active(): ?self
    {
        return self::$nativeActiveComponent?->get();
    }

    /**
     * @return \WeakReference<self>|null
     */
    public static function markActive(self $component): ?\WeakReference
    {
        $previous = self::$nativeActiveComponent;
        self::$nativeActiveComponent = \WeakReference::create($component);

        return $previous;
    }

    /**
     * @param  \WeakReference<self>|null  $previous
     */
    public static function restoreActive(?\WeakReference $previous): void
    {
        self::$nativeActiveComponent = $previous;
    }
}
