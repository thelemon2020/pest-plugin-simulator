{
    "name": "thelemon2020/pest-plugin-simulator",
    "description": "Pest plugin that drives NativePHP screens on iOS Simulators and Android Emulators.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "pestphp/pest": "^4.0 || ^5.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "NativePhp\\Simulator\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "pest": {
            "plugins": [
                "NativePhp\\Simulator\\Plugin"
            ]
        },
        "laravel": {
            "providers": [
                "NativePhp\\Simulator\\Laravel\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "lint": "@php vendor/bin/pint",
        "test:lint": "@php vendor/bin/pint --test",
        "test:types": "@php vendor/bin/phpstan analyse --no-progress",
        "hooks": "git config core.hooksPath .githooks || exit 0",
        "post-install-cmd": "@hooks",
        "post-update-cmd": "@hooks"
    },
    "minimum-stability": "stable"
}
